, 0.0, 0.0], "caps": [{"t": 0.8, "d": 0.28, "text": "Ahoi!"}, {"t": 1.08, "d": 1.13, "text": "Ich bin K\u00e4pt'n Kurt."}, {"t": 2.21, "d": 2.83, "text": "Heute erz\u00e4hle ich dir die Geschichte der Titanic \u2013"}, {"t": 5.04, "d": 1.92, "text": "des ber\u00fchmtesten Schiffs der Welt."}, {"t": 6.97, "d": 2.83, "text": "Und wie sie in nur einer einzigen Nacht unterging."}, {"t": 10.54, "d": 3.34, "text": "Die Titanic war damals das gr\u00f6\u00dfte Schiff der Welt."}, {"t": 13.89, "d": 4.14, "text": "Rund 269 Meter lang \u2013 das sind etwa zweieinhalb Fu\u00dfballfelder."}, {"t": 18.03, "d": 2.14, "text": "Viele hielten sie f\u00fcr unsinkbar."}, {"t": 20.92, "d": 0.49, "text": "Am 10."}, {"t": 21.4, "d": 4.06, "text": "April 1912 legte sie in Southampton in England ab."}, {"t": 25.46, "d": 0.73, "text": "Ihr Ziel:"}, {"t": 26.19, "d": 0.73, "text": "New York."}, {"t": 26.92, "d": 4.87, "text": "An Bord waren rund 2200 Menschen \u2013 Passagiere und Besatzung."}, {"t": 32.54, "d": 3.53, "text": "Vier Tage sp\u00e4ter fuhr sie durch den eiskalten Nordatlantik."}, {"t": 36.06, "d": 2.33, "text": "Den ganzen Tag kamen Warnungen vor Eis."}, {"t": 38.39, "d": 3.53, "text": "Trotzdem fuhr die Titanic mit hoher Geschwindigkeit weiter."}, {"t": 42.67, "d": 1.96, "text": "Um 23:40 Uhr rief der Ausguck:"}, {"t": 44.63, "d": 4.18, "text": "\u201eEisberg direkt voraus!\u201c Das Schiff versuchte noch auszuweichen."}, {"t": 48.81, "d": 1.31, "text": "Doch es war zu sp\u00e4t."}, {"t": 50.12, "d": 2.81, "text": "Der Eisberg schrammte an der Seite entlang."}, {"t": 53.68, "d": 2.6, "text": "Der Rumpf hatte 16 wasserdichte Abteilungen."}, {"t": 56.27, "d": 3.54, "text": "Mit vier gefluteten h\u00e4tte die Titanic noch schwimmen k\u00f6nnen."}, {"t": 59.82, "d": 1.71, "text": "Doch f\u00fcnf liefen voll Wasser."}, {"t": 61.53, "d": 2.01, "text": "Damit war ihr Schicksal besiegelt."}, {"t": 64.29, "d": 2.09, "text": "Und es gab ein weiteres Problem:"}, {"t": 66.38, "d": 3.01, "text": "An Bord waren nur 20 Rettungsboote \u2013 mit Platz"}, {"t": 69.4, "d": 1.51, "text": "f\u00fcr etwa 1178 Menschen."}, {"t": 70.9, "d": 2.29, "text": "Das reichte nur f\u00fcr gut die H\u00e4lfte."}, {"t": 73.19, "d": 2.55, "text": "Und viele Boote fuhren halb leer davon."}, {"t": 76.49, "d": 1.79, "text": "Langsam sank der Bug ins Meer."}, {"t": 78.28, "d": 2.32, "text": "Das Heck hob sich hoch in die Luft, bis"}, {"t": 80.6, "d": 2.02, "text": "das Schiff in zwei Teile zerbrach."}, {"t": 82.63, "d": 2.62, "text": "Um 2:20 Uhr verschwand die Titanic im Ozean."}, {"t": 86.0, "d": 2.45, "text": "Das Wasser war etwa minus zwei Grad kalt."}, {"t": 88.45, "d": 3.22, "text": "Rund 1500 Menschen verloren in dieser Nacht ihr Leben."}, {"t": 92.42, "d": 4.34, "text": "Erst gegen vier Uhr morgens erreichte das Schiff Carpathia die Ungl\u00fccksstelle."}, {"t": 96.76, "d": 3.11, "text": "Es nahm rund 700 \u00dcberlebende aus den Rettungsbooten auf."}, {"t": 100.62, "d": 2.93, "text": "Danach lag das Wrack 73 Jahre verborgen."}, {"t": 103.55, "d": 3.29, "text": "Erst 1985 fand ein Team um Robert Ballard die"}, {"t": 106.84, "d": 4.83, "text": "Titanic \u2013 in fast vier Kilometern Tiefe, zerbrochen in zwei Teile."}, {"t": 112.42, "d": 2.52, "text": "Nach dem Ungl\u00fcck wurden die Regeln ge\u00e4ndert:"}, {"t": 114.94, "d": 3.95, "text": "Seitdem muss jedes Schiff genug Rettungsboote f\u00fcr alle an Bord haben."}, {"t": 118.89, "d": 2.81, "text": "So hat die Titanic die Seefahrt sicherer gemacht."}, {"t": 121.7, "d": 2.0, "text": "Tsch\u00fcss \u2013 und bis zum n\u00e4chsten Mal!"}]}